{
  "name": "Dashboard",
  "short_name": "Dashboard",
  "description": "A self-hosted personal dashboard of resizable widgets.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#020617",
