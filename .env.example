# Port the dashboard listens on inside the container (plain HTTP).
PORT=7070

# Where SQLite DB, encryption key, and uploaded icons are stored. Mount a volume here.
DATA_DIR=/data

# Optional: override the auto-generated/persisted session secret.
# SESSION_SECRET=

# Optional: override the auto-generated/persisted API-key encryption secret.
# Changing this invalidates previously stored (encrypted) API keys.
# APP_SECRET=

# Cookie 'secure' flag behavior: auto (default, detects HTTPS via X-Forwarded-Proto), true, or false.
# COOKIE_SECURE=auto
